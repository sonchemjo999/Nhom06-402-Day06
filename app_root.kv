#:kivy 2.0
# =============================================================================
#  app_root.kv - Layout gốc chứa ScreenManager
# =============================================================================
#  Quản lý điều hướng giữa 5 màn hình chính:
#    1. HomeScreen       -> "home"      (Trang chủ + timeline thuốc)
#    2. AIScanScreen     -> "ai_scan"   (Quét đơn thuốc AI)
#    3. CrossCheckScreen -> "crosscheck" (Đối chiếu y khoa)
#    4. ChatbotScreen    -> "chatbot"   (Chatbot AI triage)
#    5. SettingsScreen   -> "settings"  (Cài đặt: Dark Mode, âm thanh...)
# =============================================================================

#:import HomeScreen screens.home_screen.HomeScreen
#:import AIScanScreen screens.ai_scan_screen.AIScanScreen
#:import CrossCheckScreen screens.crosscheck_screen.CrossCheckScreen
#:import ChatbotScreen screens.chatbot_screen.ChatbotScreen
#:import SettingsScreen screens.settings_screen.SettingsScreen

MDScreenManager:
    HomeScreen:
        name: "home"
    AIScanScreen:
        name: "ai_scan"
    CrossCheckScreen:
        name: "crosscheck"
    ChatbotScreen:
        name: "chatbot"
    SettingsScreen:
        name: "settings"
