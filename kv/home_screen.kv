#:kivy 2.0
# Trang chủ — phong cách thẻ, teal, thanh điều hướng dưới (gợi ý MyVinmec)

<MedCard>:
    orientation: "horizontal"
    size_hint_y: None
    height: "112dp"
    padding: "16dp"
    spacing: "14dp"
    radius: [16]
    elevation: 3
    md_bg_color: app.card_taken_color if self.med_taken else (app.card_unlocked_color if self.med_unlocked else app.card_normal_color)

    IconImage:
        size_hint_x: None
        width: "56dp"
        med_icon: root.med_icon

    BoxLayout:
        orientation: "vertical"
        size_hint_x: 1
        spacing: "6dp"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "30dp"
            spacing: "10dp"

            MDLabel:
                text: root.med_time
                font_style: "H6"
                theme_text_color: "Custom"
                text_color: app.text_time_color
                bold: True
                size_hint_x: None
                width: "58dp"

            MDLabel:
                text: root.med_name
                font_style: "Subtitle1"
                bold: True
                theme_text_color: "Custom"
                text_color: app.text_primary_color
                text_size: self.size
                halign: "left"
                valign: "center"

        MDLabel:
            text: root.med_dosage + "  ·  " + root.med_note
            font_style: "Body2"
            theme_text_color: "Custom"
            text_color: app.text_secondary_color
            size_hint_y: None
            height: "24dp"

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: "34dp"
            spacing: "8dp"

            MDLabel:
                text: "Đã ghi nhận" if root.med_taken else ("Chưa đến giờ uống" if not root.med_unlocked else "Đến giờ uống thuốc!")
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: app.status_taken_color if root.med_taken else (app.status_pending_color if not root.med_unlocked else app.status_unlocked_color)
                bold: root.med_unlocked and not root.med_taken
                size_hint_x: 0.42
                text_size: self.size
                halign: "left"
                valign: "center"

            MDRaisedButton:
                text: "ĐÃ UỐNG" if not root.med_taken else "Đã xong"
                md_bg_color: app.btn_taken_color if root.med_unlocked and not root.med_taken else app.btn_disabled_color
                text_color: (1, 1, 1, 1)
                font_size: "13sp"
                size_hint_x: 0.58
                height: "34dp"
                radius: [8]
                opacity: 1 if root.med_unlocked or root.med_taken else 0
                disabled: root.med_taken or not root.med_unlocked
                on_release: app.root.get_screen("home").mark_as_taken(root)


<HomeScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: app.bg_color

        # --- Header teal (tiêu đề + slogan) ---
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: "96dp"
            padding: "16dp", "14dp", "12dp", "10dp"
            spacing: "6dp"
            md_bg_color: app.theme_cls.primary_color

            BoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "32dp"

                MDLabel:
                    text: "MedReminder"
                    font_style: "H5"
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    size_hint_x: 1
                    valign: "center"

                MDIconButton:
                    icon: "cog"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    on_release: root.go_to_settings()

            MDLabel:
                text: "Nhắc nhở đúng giờ — an tâm mỗi ngày"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 0.85, 0.95, 0.95, 1
                size_hint_y: None
                height: "20dp"

        ScrollView:
            size_hint_y: 1
            bar_width: dp(4)

            MDBoxLayout:
                orientation: "vertical"
                spacing: "12dp"
                padding: "14dp", "12dp", "14dp", "20dp"
                size_hint_y: None
                height: self.minimum_height
                adaptive_height: True

                # Thẻ chào mừng
                MDCard:
                    size_hint_y: None
                    height: "76dp"
                    radius: [16]
                    elevation: 2
                    padding: "16dp"
                    md_bg_color: app.surface_color

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "4dp"

                        MDLabel:
                            text: "Xin chào"
                            font_style: "Subtitle1"
                            bold: True
                            theme_text_color: "Primary"

                        MDLabel:
                            text: "Đừng quên uống thuốc đúng giờ. Lịch hôm nay bên dưới."
                            font_style: "Caption"
                            theme_text_color: "Secondary"

                # Đồng hồ trong thẻ — giờ full-width một dòng, tránh H3 trong cột hẹp gây wrap đè lên ngày
                MDCard:
                    size_hint_y: None
                    height: "128dp"
                    radius: [16]
                    elevation: 2
                    padding: "16dp", "12dp"
                    md_bg_color: app.card_normal_color

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "10dp"

                        MDLabel:
                            id: clock_label
                            text: root.clock_display
                            font_size: "36sp"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: app.text_time_color
                            size_hint_y: None
                            text_size: self.width, None
                            height: self.texture_size[1]
                            halign: "left"
                            valign: "middle"
                            max_lines: 1

                        BoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "44dp"
                            spacing: "10dp"

                            MDLabel:
                                id: date_label
                                text: root.date_display
                                font_style: "Caption"
                                theme_text_color: "Custom"
                                text_color: app.text_secondary_color
                                halign: "left"
                                valign: "center"
                                text_size: self.size
                                size_hint_x: 0.5

                            MDBoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.5
                                spacing: "2dp"

                                MDLabel:
                                    text: "Hôm nay"
                                    font_style: "Subtitle1"
                                    bold: True
                                    theme_text_color: "Primary"
                                    halign: "right"
                                    text_size: self.size

                                MDLabel:
                                    id: day_label
                                    text: root.day_display
                                    font_style: "Caption"
                                    theme_text_color: "Custom"
                                    text_color: app.text_secondary_color
                                    halign: "right"
                                    text_size: self.size

                # Tiêu đề lịch
                MDLabel:
                    text: "Lịch uống thuốc hôm nay"
                    font_style: "H6"
                    bold: True
                    theme_text_color: "Primary"
                    size_hint_y: None
                    height: "32dp"

                MDBoxLayout:
                    id: med_list_container
                    orientation: "vertical"
                    spacing: "10dp"
                    size_hint_y: None
                    height: self.minimum_height
                    adaptive_height: True

        # --- Thanh điều hướng dưới ---
        MDCard:
            size_hint_y: None
            height: "68dp"
            radius: [18, 18, 0, 0]
            elevation: 12
            padding: "6dp", "4dp", "6dp", "8dp"
            md_bg_color: app.card_normal_color

            BoxLayout:
                orientation: "horizontal"
                spacing: "4dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.22
                    spacing: "0dp"

                    MDIconButton:
                        icon: "home"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        on_release: root.nav_home()

                    MDLabel:
                        text: "Trang chủ"
                        font_style: "Caption"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        halign: "center"
                        size_hint_y: None
                        height: "16dp"

                Widget:
                    size_hint_x: 0.06

                AnchorLayout:
                    size_hint_x: 0.28
                    anchor_y: "center"

                    MDRaisedButton:
                        text: "QUÉT ĐƠN"
                        font_size: "11sp"
                        size_hint: None, None
                        width: "88dp"
                        height: "48dp"
                        md_bg_color: app.theme_cls.primary_color
                        text_color: 1, 1, 1, 1
                        radius: [24]
                        on_release: root.go_to_scan()

                Widget:
                    size_hint_x: 0.06

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.22
                    MDIconButton:
                        icon: "message-text"
                        theme_text_color: "Custom"
                        text_color: app.text_secondary_color
                        on_release: root.go_to_chatbot()
                    MDLabel:
                        text: "Chat AI"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "center"
                        size_hint_y: None
                        height: "16dp"

                BoxLayout:
                    orientation: "vertical"
                    size_hint_x: 0.22
                    MDIconButton:
                        icon: "cog"
                        theme_text_color: "Custom"
                        text_color: app.text_secondary_color
                        on_release: root.go_to_settings()
                    MDLabel:
                        text: "Cài đặt"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "center"
                        size_hint_y: None
                        height: "16dp"
