#:kivy 2.0
# =============================================================================
#  settings_screen.kv - Màn hình Cài đặt
# =============================================================================

<SettingsScreen>:
    MDBoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Cài đặt"
            elevation: 4
            md_bg_color: app.theme_cls.primary_color
            specific_text_color: 1, 1, 1, 1
            left_action_items: [["arrow-left", lambda x: root.go_back()]]

        ScrollView:
            MDBoxLayout:
                orientation: "vertical"
                spacing: "8dp"
                padding: "16dp"
                size_hint_y: None
                height: self.minimum_height
                adaptive_height: True

                # =============================================
                # NHÓM 1: GIAO DIỆN
                # =============================================
                MDCard:
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [12, 12, 12, 12]
                    padding: "4dp"
                    md_bg_color: (0.95, 0.95, 0.95, 1) if not app.theme_manager.is_dark else (0.15, 0.15, 0.2, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "0dp"
                        size_hint_y: None
                        height: self.minimum_height

                        MDLabel:
                            text: "GIAO DIỆN"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: (0.5, 0.5, 0.5, 1) if not app.theme_manager.is_dark else (0.6, 0.6, 0.65, 1)
                            size_hint_y: None
                            height: "36dp"
                            padding: "16dp", "8dp"

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "56dp"
                            padding: "16dp", "0dp"

                            MDBoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.85

                                MDLabel:
                                    text: "Chế độ tối (Dark Mode)"
                                    font_style: "Subtitle1"
                                    bold: False
                                    theme_text_color: "Custom"
                                    text_color: (0.1, 0.1, 0.15, 1) if not app.theme_manager.is_dark else (0.95, 0.95, 0.97, 1)

                                MDLabel:
                                    text: "Nền tối, giảm mỏi mắt ban đêm"
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                                    size_hint_y: None
                                    height: "18dp"

                            Switch:
                                id: dark_mode_switch
                                size_hint_x: 0.15
                                on_active: root.toggle_dark_mode(*args)

                # =============================================
                # NHÓM 2: ÂM THANH & RUNG
                # =============================================
                MDCard:
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [12, 12, 12, 12]
                    padding: "4dp"
                    md_bg_color: (0.95, 0.95, 0.95, 1) if not app.theme_manager.is_dark else (0.15, 0.15, 0.2, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "0dp"
                        size_hint_y: None
                        height: self.minimum_height

                        MDLabel:
                            text: "ÂM THANH & RUNG"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: (0.5, 0.5, 0.5, 1) if not app.theme_manager.is_dark else (0.6, 0.6, 0.65, 1)
                            size_hint_y: None
                            height: "36dp"
                            padding: "16dp", "8dp"

                        # --- Âm thanh báo thức ---
                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "56dp"
                            padding: "16dp", "0dp"

                            MDBoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.85

                                MDLabel:
                                    text: "Âm thanh báo thức"
                                    font_style: "Subtitle1"
                                    bold: False
                                    theme_text_color: "Custom"
                                    text_color: (0.1, 0.1, 0.15, 1) if not app.theme_manager.is_dark else (0.95, 0.95, 0.97, 1)

                                MDLabel:
                                    text: "Phát âm thanh khi đến giờ uống thuốc"
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                                    size_hint_y: None
                                    height: "18dp"

                            Switch:
                                id: sound_switch
                                size_hint_x: 0.15
                                on_active: root.toggle_sound(*args)

                        # --- Rung khi báo thức ---
                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "56dp"
                            padding: "16dp", "0dp"

                            MDBoxLayout:
                                orientation: "vertical"
                                size_hint_x: 0.85

                                MDLabel:
                                    text: "Rung khi báo thức"
                                    font_style: "Subtitle1"
                                    bold: False
                                    theme_text_color: "Custom"
                                    text_color: (0.1, 0.1, 0.15, 1) if not app.theme_manager.is_dark else (0.95, 0.95, 0.97, 1)

                                MDLabel:
                                    text: "Điện thoại rung kèm âm thanh"
                                    font_style: "Caption"
                                    theme_text_color: "Secondary"
                                    size_hint_y: None
                                    height: "18dp"

                            Switch:
                                id: vibration_switch
                                size_hint_x: 0.15
                                on_active: root.toggle_vibration(*args)

                        # --- Chọn file chuông ---
                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_y: None
                            height: self.minimum_height
                            padding: "16dp", "8dp", "16dp", "12dp"
                            spacing: "8dp"

                            MDLabel:
                                text: "Kiểu chuông báo thức"
                                font_style: "Subtitle1"
                                theme_text_color: "Custom"
                                text_color: (0.1, 0.1, 0.15, 1) if not app.theme_manager.is_dark else (0.95, 0.95, 0.97, 1)

                            MDLabel:
                                id: alarm_sound_value
                                text: "..."
                                font_style: "Body2"
                                theme_text_color: "Custom"
                                text_color: (0.35, 0.45, 0.5, 1) if not app.theme_manager.is_dark else (0.65, 0.7, 0.75, 1)
                                size_hint_y: None
                                height: "22dp"

                            MDLabel:
                                text: "Âm thanh và rung lặp cho đến khi bạn bấm Đã uống hoặc Trì hoãn."
                                font_style: "Caption"
                                theme_text_color: "Secondary"
                                size_hint_y: None
                                text_size: self.width, None

                            MDBoxLayout:
                                orientation: "horizontal"
                                size_hint_y: None
                                height: "44dp"
                                spacing: "8dp"

                                MDRaisedButton:
                                    text: "Chọn âm thanh"
                                    md_bg_color: app.theme_cls.primary_color
                                    text_color: 1, 1, 1, 1
                                    size_hint_x: 0.55
                                    on_release: root.open_sound_picker()

                                MDFlatButton:
                                    text: "Nghe thử"
                                    theme_text_color: "Primary"
                                    size_hint_x: 0.45
                                    on_release: root.preview_alarm_sound()

                # =============================================
                # NHÓM 3: THÔNG TIN ỨNG DỤNG
                # =============================================
                MDCard:
                    size_hint_y: None
                    height: self.minimum_height
                    radius: [12, 12, 12, 12]
                    padding: "4dp"
                    md_bg_color: (0.95, 0.95, 0.95, 1) if not app.theme_manager.is_dark else (0.15, 0.15, 0.2, 1)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: "0dp"
                        size_hint_y: None
                        height: self.minimum_height

                        MDLabel:
                            text: "THÔNG TIN"
                            font_style: "Caption"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: (0.5, 0.5, 0.5, 1) if not app.theme_manager.is_dark else (0.6, 0.6, 0.65, 1)
                            size_hint_y: None
                            height: "36dp"
                            padding: "16dp", "8dp"

                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint_y: None
                            height: "48dp"
                            padding: "16dp", "0dp"

                            MDLabel:
                                text: "Phiên bản"
                                font_style: "Subtitle1"
                                bold: False
                                theme_text_color: "Custom"
                                text_color: (0.1, 0.1, 0.15, 1) if not app.theme_manager.is_dark else (0.95, 0.95, 0.97, 1)

                            MDLabel:
                                text: "v1.0.0"
                                font_style: "Subtitle1"
                                theme_text_color: "Secondary"
                                halign: "right"

                        BoxLayout:
                            size_hint_y: None
                            height: "1dp"
                            padding: "16dp", "0dp"

                            Widget:
                                canvas.before:
                                    Color:
                                        rgba: 0.8, 0.8, 0.8, 0.5
                                    Rectangle:
                                        pos: self.pos
                                        size: self.size

                        MDBoxLayout:
                            orientation: "vertical"
                            size_hint_y: None
                            height: "80dp"
                            padding: "16dp", "8dp"

                            MDLabel:
                                text: "MedReminder"
                                font_style: "Subtitle1"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                size_hint_y: None
                                height: "24dp"

                            MDLabel:
                                text: "Ứng dụng nhắc nhở uống thuốc thông minh.\nHỗ trợ AI đọc đơn thuốc, chatbot tư vấn sức khỏe."
                                font_style: "Caption"
                                theme_text_color: "Secondary"
                                size_hint_y: 1
