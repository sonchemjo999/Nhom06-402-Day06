#:kivy 2.0
# =============================================================================
#  alarm_popup.kv - Popup báo thức nhắc uống thuốc (Full-Screen)
# =============================================================================

<AlarmPopup>:
    title: ""
    separator_height: 0
    # Chiếm gần toàn màn hình, để một chút viền đen xung quanh
    size_hint: 0.95, 0.9
    pos_hint: {"center_x": 0.5, "center_y": 0.5}
    auto_dismiss: False
    background_color: app.alarm_bg_color

    BoxLayout:
        orientation: "vertical"
        spacing: "12dp"
        padding: "20dp"

        # --- Header: Cảnh báo ---
        MDCard:
            size_hint_y: None
            height: "60dp"
            radius: [16, 16, 16, 16]
            md_bg_color: app.alarm_header_color
            padding: "12dp"

            MDLabel:
                text: "ĐÃ ĐẾN GIỜ UỐNG THUỐC!"
                font_style: "H6"
                bold: True
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1)
                halign: "center"
                valign: "center"

        # --- Giờ uống (to, nổi bật) ---
        MDLabel:
            id: alarm_time_label
            text: root.alarm_time
            font_style: "H3"
            halign: "center"
            bold: True
            theme_text_color: "Custom"
            text_color: app.alarm_time_color
            size_hint_y: None
            height: "80dp"

        # --- Tên thuốc + liều ---
        MDCard:
            size_hint_y: None
            height: "90dp"
            radius: [12, 12, 12, 12]
            md_bg_color: app.alarm_med_card_color
            padding: "16dp"

            MDBoxLayout:
                orientation: "vertical"
                spacing: "4dp"

                MDLabel:
                    text: root.alarm_med_name
                    font_style: "H6"
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: "32dp"
                    theme_text_color: "Custom"
                    text_color: (1, 1, 1, 1) if app.theme_manager.is_dark else (0.1, 0.1, 0.15, 1)

                MDLabel:
                    text: "Liều: " + root.alarm_dosage + "  |  " + root.alarm_note
                    font_style: "Subtitle1"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: (0.7, 0.7, 0.75, 1) if app.theme_manager.is_dark else (0.3, 0.3, 0.35, 1)
                    size_hint_y: None
                    height: "28dp"

        # --- Số lần nhắc ---
        MDLabel:
            id: alarm_count_label
            text: root.alarm_count_text
            font_style: "Caption"
            halign: "center"
            theme_text_color: "Custom"
            text_color: app.alarm_warning_color
            size_hint_y: None
            height: "24dp"

        Widget:
            size_hint_y: 0.05

        # --- Nút ĐÃ UỐNG (to, nổi bật) ---
        MDRaisedButton:
            text: "ĐÃ UỐNG THUỐC"
            md_bg_color: app.btn_taken_color
            text_color: (1, 1, 1, 1)
            font_size: "20sp"
            size_hint_x: 1
            height: "60dp"
            on_release: root.on_confirm()

        # --- Nút Snooze ---
        MDFlatButton:
            text: "TRÌ HOÃN (Snooze)"
            theme_text_color: "Custom"
            text_color: app.alarm_warning_color
            font_size: "14sp"
            size_hint_x: 1
            height: "44dp"
            on_release: root.on_snooze()

        # --- Cảnh báo cuối ---
        MDLabel:
            text: "Vui lòng đối chiếu với đơn thuốc gốc trước khi uống"
            font_style: "Caption"
            halign: "center"
            theme_text_color: "Custom"
            text_color: app.alarm_warning_color
            size_hint_y: None
            height: "20dp"
