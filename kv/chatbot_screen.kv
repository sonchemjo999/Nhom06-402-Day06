#:kivy 2.0
# =============================================================================
#  chatbot_screen.kv - UI Chatbot AI Triage (giao diện Messenger)
# =============================================================================

<ChatBubble>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: "10dp"
    md_bg_color: root.bubble_color
    size_hint_x: 0.78
    pos_hint: {"right": 0.98} if root.is_user else {"x": 0.02}
    adaptive_height: True

    MDLabel:
        text: root.message_text
        font_style: "Body1"
        size_hint_y: None
        height: self.texture_size[1]
        theme_text_color: "Custom"
        text_color: (1, 1, 1, 1) if root.is_user else app.text_primary_color


<ChatbotScreen>:
    MDBoxLayout:
        orientation: "vertical"

        # --- Thanh tiêu đề ---
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "4dp", "4dp"
            md_bg_color: app.theme_cls.primary_color

            MDFlatButton:
                text: "< Trở lại"
                font_size: "15sp"
                text_color: (1, 1, 1, 1)
                bold: True
                pos_hint: {"center_y": 0.5}
                on_release: root.go_back()

            MDLabel:
                text: "Trợ lý Y tế AI"
                font_style: "H6"
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1)
                bold: True
                halign: "center"
                valign: "center"

        # --- Khu vực chat (scroll) ---
        ScrollView:
            id: chat_scroll
            do_scroll_x: False

            MDBoxLayout:
                id: chat_container
                orientation: "vertical"
                spacing: "8dp"
                padding: "8dp", "12dp"
                size_hint_y: None
                height: self.minimum_height
                adaptive_height: True

        # --- Nút cấp cứu (chỉ hiện khi RED) ---
        MDBoxLayout:
            size_hint_y: None
            height: "56dp" if root.show_emergency_button else "0dp"
            opacity: 1 if root.show_emergency_button else 0
            padding: "8dp", "4dp"

            MDRaisedButton:
                text: "TÌM BỆNH VIỆN CẤP CỨU GẦN NHẤT"
                md_bg_color: app.btn_emergency_color
                text_color: (1, 1, 1, 1)
                font_size: "14sp"
                size_hint_x: 1
                height: "48dp"
                on_release: root.find_emergency_hospital()

        # --- Thanh nhập tin nhắn ---
        MDCard:
            size_hint_y: None
            height: "60dp"
            radius: [0, 0, 0, 0]
            elevation: 4
            padding: "8dp", "4dp"

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "8dp"

                MDTextField:
                    id: chat_input
                    hint_text: "Nhập triệu chứng của bạn..."
                    mode: "round"
                    size_hint_x: 0.82
                    on_text_validate: root.send_message(self.text)

                MDRaisedButton:
                    text: "Gửi"
                    md_bg_color: app.theme_cls.primary_color
                    text_color: (1, 1, 1, 1)
                    font_size: "14sp"
                    size_hint_x: 0.18
                    pos_hint: {"center_y": 0.5}
                    on_release: root.send_message(chat_input.text)
