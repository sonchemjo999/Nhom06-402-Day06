#:kivy 2.0
# =============================================================================
#  ai_scan_screen.kv - UI Quét đơn thuốc bằng AI
# =============================================================================

<AIScanScreen>:
    MDBoxLayout:
        orientation: "vertical"

        # --- Thanh tiêu đề ---
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "4dp", "4dp"
            md_bg_color: app.theme_cls.primary_color

            MDFlatButton:
                text: "< Trở lại"
                font_size: "15sp"
                text_color: (1, 1, 1, 1)
                bold: True
                pos_hint: {"center_y": 0.5}
                on_release: root.go_back()

            MDLabel:
                text: "AI Đọc đơn thuốc"
                font_style: "H6"
                theme_text_color: "Custom"
                text_color: (1, 1, 1, 1)
                bold: True
                halign: "center"
                valign: "center"

        # --- Nội dung chính ---
        MDBoxLayout:
            orientation: "vertical"
            spacing: "20dp"
            padding: "24dp"

            Widget:
                size_hint_y: 0.15

            MDLabel:
                text: "Quét đơn thuốc bằng AI"
                font_style: "H5"
                halign: "center"
                size_hint_y: None
                height: "40dp"

            MDLabel:
                text: "Chụp ảnh hoặc tải lên đơn thuốc.\nAI sẽ tự động nhận diện thông tin thuốc."
                font_style: "Body1"
                halign: "center"
                theme_text_color: "Secondary"
                size_hint_y: None
                height: "60dp"

            # --- Spinner Loading ---
            MDBoxLayout:
                size_hint_y: None
                height: "80dp"
                padding: "20dp"

                MDSpinner:
                    size_hint: None, None
                    size: "46dp", "46dp"
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}
                    active: root.is_scanning
                    opacity: 1 if root.is_scanning else 0

            MDLabel:
                text: "Đang xử lý đơn thuốc..." if root.is_scanning else ""
                halign: "center"
                font_style: "Subtitle1"
                theme_text_color: "Custom"
                text_color: app.alarm_warning_color
                size_hint_y: None
                height: "30dp"

            Widget:
                size_hint_y: 0.3

            # --- Nút Quét ---
            MDRaisedButton:
                text: "QUÉT ĐƠN THUỐC MỚI"
                md_bg_color: app.theme_cls.primary_color if not root.is_scanning else (0.7, 0.7, 0.7, 1)
                text_color: (1, 1, 1, 1)
                font_size: "18sp"
                size_hint_x: 1
                height: "56dp"
                disabled: root.is_scanning
                on_release: root.start_scan()

            # --- Cảnh báo ---
            MDBoxLayout:
                size_hint_y: None
                height: "60dp"
                padding: "8dp"

                MDLabel:
                    text: "Kết quả AI chỉ mang tính tham khảo.\nLuôn đối chiếu với đơn thuốc gốc của bác sĩ."
                    font_style: "Caption"
                    halign: "center"
                    theme_text_color: "Custom"
                    text_color: (0.8, 0.4, 0, 1)

            Widget:
                size_hint_y: 0.1
