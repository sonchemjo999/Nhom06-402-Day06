#:kivy 2.0
# =============================================================================
#  ai_scan_screen.kv - UI Quet don thuoc (Auto Mock)
# =============================================================================
#
# Vao man hinh -> tu dong quet (random) -> CrossCheckScreen
# Khong can nut bam, khong can camera.
# =============================================================================

<AIScanScreen>:
    is_scanning: False
    scan_progress: 0

    MDBoxLayout:
        orientation: "vertical"

        # --- App Bar ---
        MDBoxLayout:
            size_hint_y: None
            height: "56dp"
            padding: "4dp", "4dp"
            md_bg_color: app.theme_cls.primary_color

            Widget:
                size_hint_x: 0.3

            MDLabel:
                text: "AI đọc đơn thuốc"
                font_style: "H6"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 1
                bold: True
                halign: "center"
                valign: "center"

            Widget:
                size_hint_x: 0.3

        # --- Noi dung chinh ---
        MDBoxLayout:
            orientation: "vertical"
            spacing: "20dp"
            padding: "24dp"
            halign: "center"

            # --- Icon quay loading ---
            Widget:
                size_hint_y: 0.4

            # --- Spinner ---
            MDSpinner:
                size_hint: None, None
                size: "64dp", "64dp"
                pos_hint: {"center_x": 0.5}
                active: root.is_scanning

            # --- Trang thai + case ---
            MDLabel:
                text: "Đang quét đơn thuốc..."
                font_style: "H5"
                halign: "center"
                size_hint_y: None
                height: "48dp"
                theme_text_color: "Primary"

            MDLabel:
                text: "Đang chờ AI đọc và phân tích đơn thuốc"
                font_style: "Body1"
                halign: "center"
                size_hint_y: None
                height: "32dp"
                theme_text_color: "Secondary"

            # --- Thanh tien trinh ---
            MDProgressBar:
                id: progress_bar
                value: root.scan_progress
                size_hint_y: None
                height: "8dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                md_bg_color: 0.85, 0.85, 0.85, 1
                color: app.theme_cls.primary_color

            # --- Spacer ---
            Widget:
                size_hint_y: 0.6

            # --- Canh bao ---
            MDBoxLayout:
                size_hint_y: None
                height: "52dp"
                padding: "8dp"
                md_bg_color: 0.95, 0.92, 0.75, 1
                radius: [8]

                MDLabel:
                    text: "Kết quả AI chỉ mang tính tham khảo. Luôn đối chiếu với đơn gốc của bác sĩ."
                    font_style: "Caption"
                    theme_text_color: "Custom"
                    text_color: 0.7, 0.45, 0, 1
                    halign: "center"
                    valign: "middle"
